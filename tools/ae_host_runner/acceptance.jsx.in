(function () {
    var cfg = @FSTR_OWNED_CONFIG@;
    var lines = [], created = false, suppressed = false, succeeded = false;
    function record(s) { lines.push(String(s)); }
    function addEffect(layer, encoding, balance) {
        var e = layer.property("ADBE Effect Parade").addProperty("FSTR LUT Color MVP");
        e.property("Input Profile").setValue(1); e.property("Exposure").setValue(balance ? 0.5 : 0);
        e.property("Temperature").setValue(balance ? 20 : 0); e.property("Tint").setValue(balance ? -10 : 0);
        e.property("Contrast").setValue(1); e.property("Saturation").setValue(100);
        e.property("Highlight Rolloff").setValue(0); e.property("Look").setValue(1);
        e.property("Look Amount").setValue(0); e.property("Mix").setValue(100);
        e.property("AE Pixel Encoding").setValue(encoding); return e;
    }
    function addQueue(comp, label) {
        record("QUEUE_BEGIN " + label);
        var q = app.project.renderQueue.items.add(comp), om = q.outputModule(1), found = false;
        for (var i = 0; i < om.templates.length; i++) if (String(om.templates[i]) === "Photoshop") found = true;
        if (!found) throw Error("Existing Photoshop template unavailable");
        om.applyTemplate("Photoshop");
        var out = om.getSettings(GetSettingsFormat.STRING);
        record("OUTPUT " + label + " FORMAT=" + out["Format"] + " CHANNELS=" + out["Channels"] + " DEPTH=" + out["Depth"] + " COLOR=" + out["Color"]);
        // Keep the existing template's premultiplied output. External comparison accounts for this.
        om.file = new File(cfg.folder + "/" + label + "_[#####].psd"); return q;
    }
    function render() {
        app.project.renderQueue.render();
        for (var i = 1; i <= app.project.renderQueue.numItems; i++)
            if (app.project.renderQueue.item(i).status !== RQItemStatus.DONE) throw Error("Render not complete");
    }
    function closeOwned() {
        if (created && app.project) { app.project.close(CloseOptions.DO_NOT_SAVE_CHANGES); created = false; }
    }
    if ($.getenv("FSTR_LUT_OWNED_TOKEN") !== cfg.nonce) return;
    if (app.project && (app.project.file !== null || app.project.numItems !== 0)) return;
    try {
        app.beginSuppressDialogs(); suppressed = true;
        record("HOST " + app.version + " BUILD " + app.buildNumber);
        for (var mode = 0; mode < 2; mode++) {
            var linear = mode === 1, label = linear ? "LINEAR" : "SRGB";
            app.newProject(); created = true; app.project.bitsPerChannel = 32;
            if (linear) {
                var profiles = app.project.listColorProfiles(), selected = null;
                for (var i = 0; i < profiles.length; i++) if (String(profiles[i]) === "sRGB IEC61966-2.1") selected = profiles[i];
                if (selected === null) throw Error("Exact sRGB working profile unavailable");
                app.project.workingSpace = selected; app.project.linearizeWorkingSpace = true;
            } else { app.project.workingSpace = ""; app.project.linearizeWorkingSpace = false; }
            record("PROJECT " + label + " BPC " + app.project.bitsPerChannel + " SPACE " + app.project.workingSpace + " LINEAR " + app.project.linearizeWorkingSpace);
            var footage = app.project.importFile(new ImportOptions(new File(cfg.alpha)));
            footage.mainSource.alphaMode = AlphaMode.STRAIGHT;
            var compName = "FSTR_" + label + "_ALPHA";
            var comp = app.project.items.addComp(compName, 256, 64, 1, 1 / 24, 24);
            var layer = comp.layers.add(footage); layer.name = "SOURCE";
            addEffect(layer, linear ? 3 : 2, true); record("EFFECT_PARAMETERS_SET " + label);
            var project = new File(cfg.project_prefix + "-" + label.toLowerCase() + ".aep");
            if (project.exists) throw Error("Owned project already exists");
            app.project.save(project); record("PROJECT_SAVED " + label);
            addQueue(comp, label + "_ALPHA"); render(); app.project.save(project);
            record("RENDER_PASS " + label); closeOwned();
            app.open(project); created = true;
            var reopened = null;
            for (var k = 1; k <= app.project.numItems; k++) if (app.project.item(k).name === compName) reopened = app.project.item(k);
            if (!reopened) throw Error("Saved composition missing");
            var e = reopened.layer("SOURCE").property("ADBE Effect Parade").property("FSTR LUT Color MVP");
            var names = ["Exposure", "Temperature", "Tint", "Contrast", "Saturation", "AE Pixel Encoding"];
            var values = [0.5, 20, -10, 1, 100, linear ? 3 : 2];
            for (var n = 0; n < names.length; n++) {
                var actual = e.property(names[n]).value; record("REOPEN " + label + " " + names[n] + "=" + actual);
                if (Math.abs(actual - values[n]) > 0.000001) throw Error("Saved parameter changed: " + names[n]);
            }
            addQueue(reopened, label + "_REOPEN"); render(); record("REOPEN_RENDER_PASS " + label); closeOwned();
        }
        app.newProject(); created = true; app.project.bitsPerChannel = 32;
        app.project.workingSpace = ""; app.project.linearizeWorkingSpace = false;
        var warmFootage = app.project.importFile(new ImportOptions(new File(cfg.source)));
        var warmComp = app.project.items.addComp("FSTR_WARM", 768, 320, 1, 1 / 24, 24);
        var warmEffect = addEffect(warmComp.layers.add(warmFootage), 2, false);
        warmEffect.property("Look").setValue(2); warmEffect.property("Look Amount").setValue(100);
        addQueue(warmComp, "WARM"); render(); record("WARM_RENDER_PASS"); closeOwned();
        succeeded = true; record("PASS_OWNED_ACCEPTANCE_SCRIPT");
    } catch (e) { record("FAIL " + String(e)); }
    finally {
        closeOwned(); if (suppressed) app.endSuppressDialogs(false);
        var report = new File(cfg.report);
        if (!report.exists) {
            report.encoding = "UTF-8"; report.lineFeed = "Unix";
            if (report.open("w")) { report.write(lines.join("\n") + "\n"); report.close(); }
        }
        // No repeat after an unknown effect. Quit only this nonce-bearing, now empty process.
        app.scheduleTask("if ($.getenv('FSTR_LUT_OWNED_TOKEN') === '" + cfg.nonce + "' && (!app.project || (app.project.file === null && app.project.numItems === 0))) app.quit();", 1000, false);
    }
})();
