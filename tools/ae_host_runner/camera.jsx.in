(function () {
    var cfg = @FSTR_OWNED_CONFIG@;
    var lines = [], suppressed = false;
    function record(s) { lines.push(String(s)); }
    function addEffect(layer, variant) {
        var e = layer.property("ADBE Effect Parade").addProperty("FSTR LUT Color MVP");
        e.property("Input Profile").setValue(1); e.property("AE Pixel Encoding").setValue(4);
        e.property("Exposure").setValue(variant ? -0.15 : 0);
        e.property("Temperature").setValue(0); e.property("Tint").setValue(0);
        e.property("Contrast").setValue(variant ? 1.02 : 1); e.property("Saturation").setValue(100);
        e.property("Highlight Rolloff").setValue(variant ? 20 : 0);
        e.property("Look").setValue(variant === 2 ? 2 : 1);
        e.property("Look Amount").setValue(variant === 2 ? 20 : 0); e.property("Mix").setValue(100);
        return e;
    }
    if ($.getenv("FSTR_LUT_OWNED_TOKEN") !== cfg.nonce) return;
    if (app.project && (app.project.file !== null || app.project.numItems !== 0)) return;
    try {
        app.beginSuppressDialogs(); suppressed = true;
        app.newProject(); app.project.bitsPerChannel = 32;
        app.project.workingSpace = ""; app.project.linearizeWorkingSpace = false;
        var footage = app.project.importFile(new ImportOptions(new File(cfg.source)));
        record("HOST " + app.version + " SOURCE_DIMENSIONS " + footage.width + "x" + footage.height);
        var source = app.project.items.addComp("FSTR_CAMERA_SCALED",720,1280,1,1/24,24);
        var movie = source.layers.add(footage); movie.name = "CAMERA_SOURCE"; movie.startTime = -cfg.frame_time;
        if (footage.width > footage.height) {
            // This owned fixture honors the supplied clip's verified display rotation.
            movie.property("ADBE Transform Group").property("ADBE Rotate Z").setValue(90);
            var scale = 1280 / footage.width * 100;
        } else var scale = 1280 / footage.height * 100;
        movie.property("ADBE Transform Group").property("ADBE Scale").setValue([scale,scale]);
        // Resample before grading so independent pixel comparison has the same spatial input.
        for (var v = 0; v < 3; v++) {
            var label = ["ORIGINAL","GRADE","WARM"][v];
            var comp = app.project.items.addComp("FSTR_CAMERA_"+label,720,1280,1,1/24,24);
            var layer = comp.layers.add(source); addEffect(layer,v);
            var q = app.project.renderQueue.items.add(comp), om = q.outputModule(1);
            om.applyTemplate("Photoshop");
            om.file = new File(cfg.folder+"/"+label+"_[#####].psd");
        }
        var display = app.project.items.addComp("FSTR_CAMERA_METADATA",720,1280,1,footage.duration,50);
        var shown = display.layers.add(footage); shown.name = "CAMERA_SOURCE";
        if (footage.width > footage.height) shown.property("ADBE Transform Group").property("ADBE Rotate Z").setValue(90);
        shown.property("ADBE Transform Group").property("ADBE Scale").setValue([scale,scale]);
        addEffect(shown,0);
        var replacement = app.project.importFile(new ImportOptions(new File(cfg.replacement)));
        replacement.name = "OWNED_NO_CAMERA_METADATA";
        var project = new File(cfg.project); if(project.exists)throw Error("Owned project exists");
        app.project.save(project); app.project.renderQueue.render();
        for(var i=1;i<=app.project.renderQueue.numItems;i++)
            if(app.project.renderQueue.item(i).status!==RQItemStatus.DONE)throw Error("Camera render failed");
        record("CAMERA_RENDER_PASS 3");
        display.time=cfg.frame_time;display.openInViewer();shown.selected=true;
        app.project.save(project); record("OWNED_PROJECT_READY_FOR_METADATA_UI");
    } catch(e) {record("FAIL "+String(e));}
    finally {
        if(suppressed)app.endSuppressDialogs(false);
        var report=new File(cfg.report);
        if(!report.exists&&report.open("w")){report.encoding="UTF-8";report.write(lines.join("\n")+"\n");report.close();}
        // Keep the saved owned project open for actual Effect Controls inspection.
    }
})();
