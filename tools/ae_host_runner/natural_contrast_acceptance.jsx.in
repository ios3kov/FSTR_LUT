(function(){var cfg=@FSTR_NATURAL_CONFIG@,owned=false;
function log(s){var f=new File(cfg.folder+'/host-report.txt');f.open('a');f.writeln(s);f.close();}
if($.getenv('FSTR_LUT_OWNED_TOKEN')!==cfg.nonce)return;
if(app.project&&(app.project.file!==null||app.project.numItems!==0)){log('BLOCKED existing project');return;}
function prop(e,n){return e.property(n)||e.property('Advanced').property(n);}
function find(n){for(var i=1;i<=app.project.numItems;i++)if(app.project.item(i).name===n)return app.project.item(i);throw new Error('Missing '+n);}
function effect(c){return c.layer(1).property('ADBE Effect Parade').property(1);}
function render(c,label,t){app.purge(PurgeTarget.ALL_CACHES);var q=app.project.renderQueue.items.add(c);q.timeSpanStart=t;q.timeSpanDuration=1/12;var om=q.outputModule(1);om.applyTemplate('Photoshop');om.file=new File(cfg.folder+'/'+label+'_[#####].psd');app.project.renderQueue.render();if(q.status!==RQItemStatus.DONE)throw new Error('Render '+label);q.remove();log('RENDER '+label);}
try{app.beginSuppressDialogs();owned=true;app.open(new File(cfg.saved_project));
var names=['Legacy Controls','Legacy ACES','Legacy Host','New 3D'];for(var i=0;i<names.length;i++)if(prop(effect(find(names[i])),'Natural Contrast').value!==0)throw new Error('Legacy default changed '+names[i]);
var c=find('Legacy Controls'),e=effect(c);if(prop(e,'Exposure').numKeys!==2||prop(e,'Exposure').expressionError||!prop(e,'Exposure').expressionEnabled||Math.abs(prop(e,'Exposure').valueAtTime(0,false)-.45)>.00001)throw new Error('Legacy keys/expression');render(c,'legacy-controls0',0);render(c,'legacy-controls6',.5);render(find('Legacy ACES'),'legacy-aces',0);render(find('Legacy Host'),'legacy-host',0);render(find('New 3D'),'new3d',0);
app.project.workingSpace='';app.project.bitsPerChannel=32;var f=app.project.importFile(new ImportOptions(new File(cfg.folder+'/../controlled-flat.png')));c=app.project.items.addComp('Fresh Natural',1280,720,1,1,12);var l=c.layers.add(f);e=l.property('ADBE Effect Parade').addProperty(cfg.match);if(prop(e,'Natural Contrast').value!==1)throw new Error('Fresh default not natural');prop(e,'Contrast').setValue(1.4);render(c,'natural',0);prop(e,'Natural Contrast').setValue(0);render(c,'legacy',0);prop(e,'Natural Contrast').setValue(1);prop(e,'Look').setValue(9);render(c,'natural-teal',0);
prop(e,'Smart Color Grading').setValue(1);render(c,'smart-natural0',0);prop(e,'Natural Contrast').setValue(0);render(c,'smart-legacy',0);prop(e,'Natural Contrast').setValue(1);render(c,'smart-natural1',0);
var file=cfg.folder+'/natural-contrast.aep';app.project.save(new File(file));app.project.close(CloseOptions.DO_NOT_SAVE_CHANGES);app.open(new File(file));if(prop(effect(find('Fresh Natural')),'Natural Contrast').value!==1||prop(effect(find('Legacy Controls')),'Natural Contrast').value!==0)throw new Error('Natural switch save/reopen');log('PASS legacy/fresh default migration, keys/expression, contrast, Smart switches and save/reopen');
}catch(e){log('FAIL '+e.message+' line='+e.line);}finally{if(owned)app.project.close(CloseOptions.DO_NOT_SAVE_CHANGES);app.endSuppressDialogs(false);app.scheduleTask("if ($.getenv('FSTR_LUT_OWNED_TOKEN') === '"+cfg.nonce+"') app.quit();",1000,false);}})();