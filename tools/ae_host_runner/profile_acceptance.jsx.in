(function(){
var cfg=@FSTR_PROFILE_CONFIG@,owned=false;
function log(s){var f=new File(cfg.folder+'/host-report.txt');f.encoding='UTF-8';if(!f.open('a'))throw new Error('Report unavailable');f.writeln(s);f.close();}
if($.getenv('FSTR_LUT_OWNED_TOKEN')!==cfg.nonce)return;
if(app.project&&(app.project.file!==null||app.project.numItems!==0)){log('BLOCKED existing project');return;}
function input(e){var p=e.property('Input Profile');if(!p&&e.property('Advanced'))p=e.property('Advanced').property('Input Profile');if(!p)throw new Error('Input profile missing');return p;}
function add(name,profile,code){var c=app.project.items.addComp(name,64,64,1,1,12),l=c.layers.addSolid([code,code,code],'Owned encoded gray fixture',64,64,1,1),e=l.property('ADBE Effect Parade').addProperty(cfg.match);if(input(e).value!==1)throw new Error('Fresh input default changed');if(profile!==1)input(e).setValue(profile);return c;}
function render(c,label){app.purge(PurgeTarget.ALL_CACHES);var q=app.project.renderQueue.items.add(c);q.timeSpanStart=0;q.timeSpanDuration=1/12;q.outputModule(1).applyTemplate('Photoshop');q.outputModule(1).file=new File(cfg.folder+'/'+label+'_[#####].psd');app.project.renderQueue.render();if(q.status!==RQItemStatus.DONE)throw new Error('Render '+label);q.remove();log('RENDER '+label);}
function find(name){for(var i=1;i<=app.project.numItems;i++)if(app.project.item(i).name===name)return app.project.item(i);throw new Error('Missing '+name);}
function verify(name,value){var c=find(name),e=c.layer(1).property('ADBE Effect Parade').property(1);if(e.matchName!==cfg.match||input(e).value!==value)throw new Error('Saved input changed '+name);log('VALUE '+name+' '+value);return c;}
try{
app.beginSuppressDialogs();owned=true;
if(cfg.phase==='baseline'){
 app.newProject();app.project.workingSpace='';app.project.bitsPerChannel=32;
 render(add('LegacyHost',1,.18),'legacy-host');render(add('LegacySony',2,420/1023),'legacy-sony');
 app.project.save(new File(cfg.saved_project));log('PASS baseline Host/Sony project');
}else{
 app.open(new File(cfg.saved_project));render(verify('LegacyHost',1),'legacy-host');render(verify('LegacySony',2),'legacy-sony');
 for(var v=3;v<=7;v++){var c=add('Profile'+v,v,cfg.gray_codes[v-3]);render(c,'profile'+v);}
 var path=cfg.folder+'/profiles-reopened.aep';app.project.save(new File(path));app.project.close(CloseOptions.DO_NOT_SAVE_CHANGES);app.open(new File(path));
 verify('LegacyHost',1);verify('LegacySony',2);for(var v=3;v<=7;v++)verify('Profile'+v,v);
 log('PASS appended profiles, legacy Host/Sony and save/reopen');
}
}catch(e){log('FAIL '+String(e.message)+' line='+String(e.line));}finally{if(owned)app.project.close(CloseOptions.DO_NOT_SAVE_CHANGES);app.endSuppressDialogs(false);app.scheduleTask("if ($.getenv('FSTR_LUT_OWNED_TOKEN') === '"+cfg.nonce+"') app.quit();",1000,false);}
})();
